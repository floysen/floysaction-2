{
 "duration": 78.809,
 "speech_start": 0.05,
 "speech_end": 78.47,
 "paragraphs": [
  {
   "index": 0,
   "start": 0.05,
   "end": 4.28,
   "text": "لو حفرت حفرة في حوش بيتك وعبيتها موية، مبروك، صار عندك مسبح!"
  },
  {
   "index": 1,
   "start": 4.53,
   "end": 8.52,
   "text": "بس ثاني يوم، الموية تتسرب في الأرض، والجدران الطينية تبدأ تنهار."
  },
  {
   "index": 2,
   "start": 8.78,
   "end": 14.89,
   "text": "عشان كذا، تركّب شبكة حديد وترشّ عليها طبقة سميكة من الخرسانة. كذا صار المسبح يمسك الموية."
  },
  {
   "index": 3,
   "start": 15.21,
   "end": 22.39,
   "text": "لكن إذا فضّيته عشان تنظفه، الموية الجوفية اللي تحت تدفعه لفوق، وممكن تطلّع المسبح كامل من الأرض، كأنه قارب!"
  },
  {
   "index": 4,
   "start": 22.65,
   "end": 32.96,
   "text": "الحل؟ تركّب صمام صغير في الأرضية. إذا زاد ضغط الموية الجوفية، يفتح ويسمح لها تدخل، وبكذا يمنع المسبح من إنه يرتفع. هذا يسمونه صمام الضغط الهيدروستاتيكي."
  },
  {
   "index": 5,
   "start": 33.33,
   "end": 44.53,
   "text": "لكن بعد أسبوع تحت الشمس، الموية الراكدة تصير خضرا، وهنا تحتاج مضخة. تسحب الموية، وتدفعها داخل خزان مليان رمل يحجز الأوساخ، وترجع الموية نظيفة. وهذا فلتر الرمل."
  },
  {
   "index": 6,
   "start": 44.85,
   "end": 55.54,
   "text": "بس الأوراق تطفو، والأوساخ الثقيلة تنزل للقاع. عشان كذا، تركّب فتحة عند سطح الموية تسحب الأوراق، اسمها السكيمر، وفتحة ثانية في أعمق نقطة تسحب الأوساخ اللي تحت."
  },
  {
   "index": 7,
   "start": 55.88,
   "end": 61.66,
   "text": "وبعدين توجّه الموية النظيفة بشكل جانبي، عشان تدور داخل المسبح وتدفع الأوساخ باتجاه السكيمر."
  },
  {
   "index": 8,
   "start": 62.07,
   "end": 66.57,
   "text": "لكن البكتيريا أصغر من إن الرمل يمسكها، فهنا تضيف الكلور عشان يقضي عليها."
  },
  {
   "index": 9,
   "start": 66.83,
   "end": 73.02,
   "text": "والريحة القوية اللي تشمّها في المسبح؟ مو بالضرورة من الكلور نفسه، غالبًا من تفاعله مع العرق وبقايا المواد العضوية."
  },
  {
   "index": 10,
   "start": 73.33,
   "end": 76.05,
   "text": "باقي تركّب البلاط، والدرج، ولوح القفز..."
  },
  {
   "index": 11,
   "start": 76.33,
   "end": 78.47,
   "text": "ومبروك عليك! بنيت مسبحك بنفسك."
  }
 ],

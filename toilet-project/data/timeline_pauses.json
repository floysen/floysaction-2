{
 "duration": 83.058,
 "speech_start": 0.05,
 "speech_end": 82.73,
 "paragraphs": [
  {
   "index": 0,
   "start": 0.05,
   "end": 4.44,
   "text": "لو حفرت حفرة في حوش بيتك وبنيت فوقها غرفة صغيرة، صار عندك دورة مياه!"
  },
  {
   "index": 1,
   "start": 4.7,
   "end": 10.64,
   "text": "بس المشكلة؟ الريحة لا تُطاق، والذباب متجمّع عليها، ويجي يوم وتمتلي الحفرة بالكامل."
  },
  {
   "index": 2,
   "start": 10.99,
   "end": 16.96,
   "text": "عشان كذا، تركّب كرسي حمّام داخل البيت، وتوصّله بأنبوب يصب في شبكة الصرف الصحي تحت الشارع."
  },
  {
   "index": 3,
   "start": 17.24,
   "end": 22.95,
   "text": "لكن الموية داخل الأنبوب ما تتحرك من نفسها، فلازم تصب وراها دلو موية يدفع كل شيء بعيد."
  },
  {
   "index": 4,
   "start": 23.32,
   "end": 27.97,
   "text": "بس فيه مشكلة ثانية... غازات المجاري تقدر ترجع من نفس الأنبوب وتدخل بيتك!"
  },
  {
   "index": 5,
   "start": 28.22,
   "end": 36.18,
   "text": "عشان تمنعها، تثني الأنبوب على شكل حرف S، بحيث تبقى فيه كمية موية تسد الطريق على الغازات. وهذا يسمونه مصيدة الروائح."
  },
  {
   "index": 6,
   "start": 36.44,
   "end": 41.98,
   "text": "لكن الانحناءة هذي تحجز الفضلات بعد، فالحل إنك تنزّل كمية موية كبيرة دفعة وحدة."
  },
  {
   "index": 7,
   "start": 42.3,
   "end": 50.08,
   "text": "الموية تملأ الانحناءة، ولما تندفع من الجهة الثانية، تسحب معها اللي داخل الكرسي وتفضّيه بالكامل. هذي يسمونها ظاهرة السيفون."
  },
  {
   "index": 8,
   "start": 50.31,
   "end": 54.87,
   "text": "وحتى صوت القرقرة اللي تسمعه بنهاية كل سحبة؟ هذا من دخول الهواء بعد ما تسحب الموية."
  },
  {
   "index": 9,
   "start": 55.2,
   "end": 62.07,
   "text": "لكن محد يبي يجلس يشيل دلاء موية كل مرة، عشان كذا تركّب خزان خلف الكرسي، فيه سدادة مطاطية ومقبض يرفعها، وعوّامة تقفل دخول الموية إذا امتلأ الخزان."
  },
  {
   "index": 10,
   "start": 62.35,
   "end": 66.78,
   "text": "بس اندفاع الموية داخل الأنبوب ممكن يسحب الهواء من مصيدة الروائح، ويخلّيها تنشف، وبكذا ترجع الغازات!"
  },
  {
   "index": 11,
   "start": 66.96,
   "end": 72.51,
   "text": "عشان كذا، تمد أنبوب تهوية إضافي يطلع من الصرف إلى فوق السطح، عشان يدخل الهواء ويوازن الضغط."
  },
  {
   "index": 12,
   "start": 72.68,
   "end": 77.89,
   "text": "والأنبوب اللي تشوفه طالع من سطح بيتك؟ مو مدخنة... هذا اللي يخلّي دورة المياه تتنفّس!"
  },
  {
   "index": 13,
   "start": 78.29,
   "end": 79.96,
   "text": "ركّب المقعد والغطاء..."
  },
  {
   "index": 14,
   "start": 80.28,
   "end": 82.73,
   "text": "ومبروك عليك! بنيت دورة مياه بنفسك!"
  }
 ],
